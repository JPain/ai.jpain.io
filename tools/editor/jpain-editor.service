# jpain.io editor on Case: https://case.tail09e786.ts.net:8099/ (tailnet only).
# It listens on localhost; Tailscale serves it over HTTPS with the tailnet certificate:
#   sudo tailscale serve --bg --https=8099 http://127.0.0.1:8099
# Install: sudo install -m644 jpain-editor.service /etc/systemd/system/ && sudo systemctl enable --now jpain-editor
[Unit]
Description=jpain.io editor (tailnet only)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=james
WorkingDirectory=/home/james/ops/blog
ExecStart=/mnt/work/venvs/blog/bin/python /home/james/ops/blog/tools/editor/server.py --port 8099 --bind 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
